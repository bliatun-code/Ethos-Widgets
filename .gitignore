# Deny everything by default; allow only the public package.
# Ignoring a file does not remove it if it is already tracked.
*
!/.gitignore
!/README.md
!/LICENSE
!/LICENSE.md
!/NOTICE.md
!/CHANGELOG.md
!/docs/
!/docs/*.md
!/scripts/
!/scripts/*/
!/scripts/*/*.lua

# Generated bytecode, private state and diagnostics never belong here.
*.luac
*.bin
*.cfg
*.dat
*.log
*.csv
*.zip
*.7z
*.rar
notes/
tests/
archive/
releases/
assets/
models/
bitmaps/
audio/
.simulator/
VDTest/
