# Explicit public-package allowlist. Tracked files are not removed by ignore rules.
*
!/.gitignore
!/README.md
!/LICENSE
!/NOTICE.md
!/CHANGELOG.md
!/docs/
!/docs/*.md
!/docs/images/
!/docs/images/*.png
!/docs/images/README.md
!/scripts/
!/scripts/VoltDeck/
!/scripts/VoltDeck/main.lua

# Never publish generated bytecode, private state or diagnostic tools.
*.luac
*.bin
*.cfg
*.dat
*.log
*.csv
*.zip
*.7z
*.rar
notes/
tests/
archive/
releases/
models/
bitmaps/
audio/
.simulator/
VDTest/

